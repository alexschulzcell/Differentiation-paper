# --- Raw data -------------------------------------------------------------
# About 98 GB, all of it public at GEO, ArrayExpress and EMBL-EBI. The
# accessions are listed in Supplementary Table 1 and in code/00_setup.md.
data_raw/

# --- Working material, not part of the record -----------------------------
# Session notes, superseded drafts and audit logs. Kept locally, not published.
_archive/

# --- Build output ---------------------------------------------------------
# The submission package is built from the sources by
# code/64_build_submission.py. The repository holds the sources, not the
# product.
submission/

# --- Superseded intermediates ---------------------------------------------
derived_data/_ueberholt/

# --- Machine artefacts ----------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/
node_modules/
Rplots.pdf

# Pickle files are executed on load and do not belong in a public repository;
# they are reproducible from the CSV files in the same folders.
*.pkl
*.h5ad

# OneDrive conflict copies and Office lock files
*-PC*
~$*
